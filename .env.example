# Configuração de Pool de Chaves para o Overclock CLI
# O CLI detecta automaticamente qualquer uma destas opções:

# Opção 1: Chave única
GEMINI_API_KEY=AIzaSyYourPrimaryApiKeyHere

# Opção 2: Pool enumerado (Failover automático e instantâneo no HTTP 429)
GEMINI_API_KEY_1=AIzaSyKeyOne...
GEMINI_API_KEY_2=AIzaSyKeyTwo...
GEMINI_API_KEY_3=AIzaSyKeyThree...
GEMINI_API_KEY_4=AIzaSyKeyFour...

# Opção 3: Lista separada por vírgulas
# GEMINI_API_KEYS=key1,key2,key3,key4
